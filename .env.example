# Nunca coloque credenciais reais neste arquivo.
PORT=3000
BIMER_BASE_URL=https://servidor-bimer.example
BIMER_USERNAME=
BIMER_PASSWORD=
BIMER_TIMEOUT_MS=15000
BIMER_REFRESH_MARGIN_SECONDS=60
# Swagger não informa a unidade. Use seconds somente após validar em homologação.
BIMER_EXPIRES_IN_UNIT=seconds
ERP_SQL_CONNECTION_STRING=Server=localhost;Database=Bimer;User Id=bimer_readonly;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=false
ERP_CODE_TYPE_ID=00A0000002
STOCK_COMPANY_CODES=1
STOCK_SECTOR_IDS=00A0000008
PRICE_TABLE_CODE=01
PRICE_TABLE_ID=00A000001Q
API_KEYS_SHA256=sha256_da_chave_do_consumidor
ALLOWED_ORIGINS=https://app.example
STATE_DB_PATH=./data/integration.db
SYNC_INITIAL_CURSOR=
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=100
SYNC_CONCURRENCY=5
# Só habilite após confirmar que maiorVersaoRegistro é o cursor seguro do lote retornado.
SYNC_CURSOR_SEMANTICS_CONFIRMED=false
